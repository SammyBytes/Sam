provider LocalOpenAI {
  protocol: "openai-compatible",
  base_url: "http://127.0.0.1:18787/v1",
  api_key: env("GROQ_API_KEY")
}

schema CodeAudit {
  approved: boolean,
  severity: string,
  summary: string
}

agent CodeAuditor {
  provider: LocalOpenAI,
  model: "e2e-auditor",
  system_prompt: "You are a strict code auditor. Return only the requested JSON.",
  temperature: 0.1,
  timeout: 30
}

agent RawSummarizer {
  provider: LocalOpenAI,
  model: "e2e-summarizer",
  system_prompt: "You are a concise summarizer. Return plain text.",
  timeout: 30
}

flow main(input: string) {
  let result = use CodeAuditor<CodeAudit>(input)

  if (!result.ok) {
    return result
  }

  return result.value
}

flow summarize(input: string) {
  let result = use unsafe RawSummarizer(input)

  if (!result.ok) {
    return result
  }

  return result.value
}
