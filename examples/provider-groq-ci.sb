provider Groq {
  protocol: "openai-compatible",
  base_url: env("GROQ_BASE_URL"),
  api_key: env("GROQ_API_KEY")
}

schema CodeAudit {
  approved: boolean,
  severity: string,
  summary: string
}

schema AuditSummary {
  summary: string
}

agent Auditor {
  provider: Groq,
  model: env("GROQ_MODEL"),
  system_prompt: "You are a strict code auditor. Return only the requested JSON.",
  temperature: 0,
  timeout: 30
}

agent Summarizer {
  provider: Groq,
  model: env("GROQ_MODEL"),
  system_prompt: "Summarize the audit in one short sentence. Return only the requested JSON.",
  temperature: 0,
  timeout: 30
}

flow main(input: string) {
  let audit = use Auditor<CodeAudit>(input)
  if (!audit.ok) {
    return audit
  }

  let prompt = `Severity: ${audit.value.severity}. Finding: ${audit.value.summary}`
  let summary = use Summarizer<AuditSummary>(prompt)
  if (!summary.ok) {
    return summary
  }

  return summary.value
}
