{
  "name": "sam",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "sam": "bun run packages/cli/src/cli.ts",
    "ast": "bun run packages/cli/src/cli.ts ast",
    "build": "bun run --filter '*' build",
    "build:bin": "bun run --filter @sam-lang/cli build:bin",
    "test": "bun test"
  },
  "devDependencies": {
    "@sam-lang/compiler": "workspace:*",
    "@sam-lang/runtime": "workspace:*",
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
