# ---------------------------------------------------------------------------
# Sam provider configuration
#
# Copy this file to .env and replace the placeholders with your own values:
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real API keys. Reference these variables
# from a .sb program with env("VAR_NAME"), for example:
#
#   provider Groq {
#     protocol: "openai-compatible",
#     base_url: env("GROQ_BASE_URL"),
#     api_key: env("GROQ_API_KEY")
#   }
# ---------------------------------------------------------------------------

# Groq — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama — https://ollama.com (no API key required by default)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Custom OpenAI-compatible server
CUSTOM_OPENAI_BASE_URL=http://localhost:8080/v1
CUSTOM_OPENAI_API_KEY=your_custom_api_key
CUSTOM_OPENAI_MODEL=your_model_name
