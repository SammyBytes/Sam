{
  "name": "@sam-lang/compiler",
  "version": "0.4.0",
  "description": "Bootstrap TypeScript compiler for the Sam (.sb) DSL. TEMPORARY TOOLCHAIN: it will be deprecated and retired in v1.0.0 when Sam achieves self-hosting.",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lexer": "./src/lexer/index.ts",
    "./parser": "./src/parser/index.ts",
    "./codegen": "./src/codegen/index.ts"
  },
  
  "private": true,
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "test": "bun test"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sam",
    "dsl",
    "compiler",
    "zod",
    "agents",
    "bootstrap"
  ],
  "sam": {
    "toolchain": "bootstrap",
    "status": "temporary",
    "retirementVersion": "1.0.0",
    "note": "This TypeScript compiler exists only until the Sam self-hosted compiler replaces it in v1.0.0."
  },
  "dependencies": {
    "@sam-lang/runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7"
  }
}
